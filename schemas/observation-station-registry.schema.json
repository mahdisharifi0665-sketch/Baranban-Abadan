{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/mahdisharifi0665-sketch/Baranban-Abadan/blob/main/schemas/observation-station-registry.schema.json",
  "title":"Baranban Observation Station Registry","type":"object","additionalProperties":false,
  "required":["registry_version","target","stations","providers"],
  "properties":{
    "registry_version":{"const":"1.0.0"},
    "target":{"type":"object","additionalProperties":false,"required":["name","latitude","longitude"],"properties":{"name":{"const":"Abadan"},"latitude":{"const":28.0794},"longitude":{"const":51.7694}}},
    "stations":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["station_id","name","country","latitude","longitude","distance_from_abadan_km","station_role","precipitation_status","direct_abadan_gauge","source_urls","evidence_note"],"properties":{
      "station_id":{"type":"string","minLength":1},"name":{"type":"string","minLength":1},"country":{"type":"string","minLength":1},
      "wmo_id":{"type":["string","null"]},"icao_id":{"type":["string","null"]},"noaa_gsod_station_id":{"type":"string","pattern":"^\\d{11}$"},
      "latitude":{"type":"number","minimum":-90,"maximum":90},"longitude":{"type":"number","minimum":-180,"maximum":180},
      "elevation_m":{"type":["number","null"]},"distance_from_abadan_km":{"type":"number","minimum":0},
      "station_role":{"enum":["nearest_historical_reference","regional_comparison","supplementary_synoptic"]},
      "precipitation_status":{"enum":["historical_archive_candidate","not_available_from_referenced_feed","requires_live_parameter_verification","not_yet_verified","verified_sparse_daily_archive"]},
      "direct_abadan_gauge":{"const":false},"operational_ingestion_enabled":{"const":false},"archive_ingestion_enabled":{"type":"boolean"},
      "source_urls":{"type":"array","minItems":1,"items":{"type":"string","format":"uri"}},"evidence_note":{"type":"string","minLength":10}
    }}},
    "providers":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["provider_id","name","status","capability","access_requirement","source_url","notes"],"properties":{
      "provider_id":{"type":"string"},"name":{"type":"string"},"status":{"enum":["credential_gated_candidate","not_suitable_for_foreign_precip_feed","historical_context_only","verified_public_daily_archive"]},
      "capability":{"type":"string"},"access_requirement":{"type":"string"},"source_url":{"type":"string","format":"uri"},"notes":{"type":"string"}
    }}}
  }
}