{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mahdisharifi0665-sketch/Baranban-Abadan/blob/main/schemas/rain-observation.schema.json",
  "title": "Baranban Rain Gauge Observation",
  "description": "Versioned, traceable rain-gauge observation for Abadan and explicitly identified nearby stations.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","observation_id","station","source","observed_start_utc","observed_end_utc","retrieved_at_utc","value_mm","measurement_kind","quality_status","quality_flags"],
  "properties": {
    "schema_version": {"const":"1.0.0"},
    "observation_id": {"type":"string","minLength":1},
    "station": {
      "type":"object","additionalProperties":false,
      "required":["station_id","name","latitude","longitude","timezone"],
      "properties":{
        "station_id":{"type":"string","minLength":1},
        "name":{"type":"string","minLength":1},
        "latitude":{"type":"number","minimum":-90,"maximum":90},
        "longitude":{"type":"number","minimum":-180,"maximum":180},
        "elevation_m":{"type":["number","null"]},
        "timezone":{"type":"string","minLength":1},
        "distance_from_abadan_km":{"type":["number","null"],"minimum":0}
      }
    },
    "source":{"type":"object","additionalProperties":false,"required":["provider","source_type"],"properties":{
      "provider":{"type":"string","minLength":1},
      "source_type":{"enum":["official_station","personal_gauge","api","manual_report","gridded_estimate"]},
      "source_reference":{"type":["string","null"]},
      "instrument":{"type":["string","null"]}
    }},
    "observed_start_utc":{"type":"string","format":"date-time"},
    "observed_end_utc":{"type":"string","format":"date-time"},
    "retrieved_at_utc":{"type":"string","format":"date-time"},
    "value_mm":{"type":["number","null"],"minimum":0},
    "measurement_kind":{"enum":["interval_total","cumulative_counter"]},
    "quality_status":{"enum":["raw","accepted","suspect","rejected","missing"]},
    "quality_flags":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "counter_reset":{"type":"boolean"},
    "notes":{"type":["string","null"]}
  }
}